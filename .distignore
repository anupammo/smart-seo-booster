# Files and folders excluded from the WordPress.org build/deploy.
# Keeps the shipped plugin lean — only runtime code + readme.txt go out.

/.git
/.github
/.gitignore
/.distignore
/docs
/STRATEGY.md
/README.md
/CONTRIBUTING.md
/CHANGELOG.md

# Dev/tooling artifacts
/node_modules
/tests
/.wordpress-org
*.map
*.zip
