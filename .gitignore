# WordPress Plugin Development .gitignore

# Environment Files
.env
.env.local
.env.production

# OS Generated Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency Directories (if using npm/composer locally)
node_modules/
vendor/

# Build Output (development only)
/build/

# Cache Files
.cache/
.tmp/
.temp/

# Backup Files
*.bak
*.backup
*.old

# Test Files (local testing)
.phpunit.result.cache

# Local Development
local-config.php