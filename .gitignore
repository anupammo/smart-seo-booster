# WordPress Plugin Development .gitignore

# WordPress Core Files (if included)
/wp-admin/
/wp-content/
/wp-includes/
wp-config.php
wp-config-sample.php
.htaccess
index.php
license.txt
readme.html

# Environment and IDE Files
.env
.env.local
.env.production
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE and Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime Data
pids
*.pid
*.seed
*.pid.lock

# Dependency Directories
node_modules/
vendor/
composer.lock

# Build Output
dist/
build/
public/build/

# Cache Files
.cache/
.tmp/
.temp/

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Plugin Specific
/languages/*.mo
/assets/src/

# Development Tools
/tools/
/scripts/
/.github/workflows/

# Backup Files
*.bak
*.backup
*.old
*.orig

# Archive Files
*.zip
*.tar.gz
*.rar

# Test Files
/tests/
/test/
phpunit.xml
.phpunit.result.cache

# Documentation Build
/docs/_site/
/docs/.jekyll-cache/

# Plugin Assets (if using build tools)
/src/
/assets/raw/
package.json
package-lock.json
webpack.config.js
gulpfile.js
gruntfile.js

# Local Development
local-config.php
wp-config-local.php

# Security
.htpasswd
.htaccess.bak