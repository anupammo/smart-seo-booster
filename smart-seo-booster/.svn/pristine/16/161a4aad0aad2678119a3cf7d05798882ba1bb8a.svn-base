<svg width="128" height="128" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg-grad-128" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0073aa;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#005177;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="128" height="128" rx="12" fill="url(#bg-grad-128)"/>
  
  <!-- Rocket -->
  <g transform="translate(64, 50)">
    <path d="M -10,25 L -10,0 Q -10,-20 0,-30 Q 10,-20 10,0 L 10,25 Z" fill="#FFFFFF"/>
    <circle cx="0" cy="-10" r="6" fill="#0073aa"/>
    <path d="M -10,12 L -18,25 L -10,25 Z" fill="#E0E0E0"/>
    <path d="M 10,12 L 18,25 L 10,25 Z" fill="#E0E0E0"/>
    <ellipse cx="0" cy="30" rx="8" ry="10" fill="#f0b849" opacity="0.9"/>
  </g>
  
  <!-- Checkmark Badge -->
  <g transform="translate(95, 95)">
    <circle cx="0" cy="0" r="15" fill="#00a32a"/>
    <path d="M -6,0 L -3,5 L 6,-5" stroke="#FFFFFF" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
