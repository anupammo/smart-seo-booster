<svg width="1280" height="720" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="screen-bg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#f0f0f1;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffffff;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="1280" height="720" fill="url(#screen-bg)"/>
  
  <!-- Header -->
  <rect x="0" y="0" width="1280" height="60" fill="#0073aa"/>
  <text x="40" y="40" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="#FFFFFF">
    Smart SEO Booster - Dashboard
  </text>
  
  <!-- Main Content Area -->
  <rect x="40" y="100" width="1200" height="580" rx="8" fill="#FFFFFF" stroke="#dcdcde" stroke-width="1"/>
  
  <!-- Score Card -->
  <g transform="translate(150, 180)">
    <rect x="-80" y="-60" width="160" height="180" rx="8" fill="#f0f0f1"/>
    <circle cx="0" cy="0" r="50" fill="none" stroke="#00a32a" stroke-width="6"/>
    <text x="0" y="15" font-family="Arial, sans-serif" font-size="36" font-weight="bold" fill="#1e1e1e" text-anchor="middle">85</text>
    <text x="0" y="80" font-family="Arial, sans-serif" font-size="14" fill="#757575" text-anchor="middle">SEO Score</text>
  </g>
  
  <!-- Metrics List -->
  <g transform="translate(350, 140)">
    <text x="0" y="0" font-family="Arial, sans-serif" font-size="20" font-weight="bold" fill="#1e1e1e">SEO Audit Results</text>
    
    <!-- Metric 1 -->
    <circle cx="10" cy="40" r="8" fill="#00a32a"/>
    <text x="30" y="45" font-family="Arial, sans-serif" font-size="16" fill="#1e1e1e">Title Tag Optimization</text>
    <rect x="30" y="55" width="700" height="8" rx="4" fill="#e0e0e0"/>
    <rect x="30" y="55" width="630" height="8" rx="4" fill="#00a32a"/>
    
    <!-- Metric 2 -->
    <circle cx="10" cy="100" r="8" fill="#f0b849"/>
    <text x="30" y="105" font-family="Arial, sans-serif" font-size="16" fill="#1e1e1e">Meta Description</text>
    <rect x="30" y="115" width="700" height="8" rx="4" fill="#e0e0e0"/>
    <rect x="30" y="115" width="490" height="8" rx="4" fill="#f0b849"/>
    
    <!-- Metric 3 -->
    <circle cx="10" cy="160" r="8" fill="#00a32a"/>
    <text x="30" y="165" font-family="Arial, sans-serif" font-size="16" fill="#1e1e1e">Content Quality</text>
    <rect x="30" y="175" width="700" height="8" rx="4" fill="#e0e0e0"/>
    <rect x="30" y="175" width="560" height="8" rx="4" fill="#00a32a"/>
    
    <!-- Metric 4 -->
    <circle cx="10" cy="220" r="8" fill="#00a32a"/>
    <text x="30" y="225" font-family="Arial, sans-serif" font-size="16" fill="#1e1e1e">Schema Markup</text>
    <rect x="30" y="235" width="700" height="8" rx="4" fill="#e0e0e0"/>
    <rect x="30" y="235" width="700" height="8" rx="4" fill="#00a32a"/>
    
    <!-- Metric 5 -->
    <circle cx="10" cy="280" r="8" fill="#46b450"/>
    <text x="30" y="285" font-family="Arial, sans-serif" font-size="16" fill="#1e1e1e">Performance Score</text>
    <rect x="30" y="295" width="700" height="8" rx="4" fill="#e0e0e0"/>
    <rect x="30" y="295" width="595" height="8" rx="4" fill="#46b450"/>
  </g>
  
  <!-- Footer -->
  <text x="640" y="700" font-family="Arial, sans-serif" font-size="12" fill="#757575" text-anchor="middle">
    Smart SEO Booster v2.1.0 - Main Dashboard
  </text>
</svg>
